# ==============================================================================
# Ctrl Short Environment Configuration
# ==============================================================================

# Frontend Configuration
# ------------------------------------------------------------------------------
# In local development, points to the local backend server (http://localhost:4000).
# In production, set to your AWS API Gateway URL or custom domain (e.g., https://api.ctrlshort.io).
VITE_API_BASE_URL=http://localhost:4000

# Backend & Serverless Runtime Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:5173

# AWS Region (e.g. us-east-1, eu-west-1)
AWS_REGION=us-east-1

# Amazon DynamoDB Table Names
URLS_TABLE_NAME=CtrlShort-Urls
ANALYTICS_TABLE_NAME=CtrlShort-Analytics
USER_GSI_NAME=userId-createdAt-index

# Amazon SQS Click Ingestion Queue URL
ANALYTICS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/CtrlShort-AnalyticsQueue

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=us-east-1_exampleId
COGNITO_CLIENT_ID=exampleAppClientId12345678

# Privacy Salt for Non-Reversible Visitor Hashes (Rotate periodically)
ANALYTICS_SALT=ctrl-short-privacy-salt-production-value
