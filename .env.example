# ==============================================================================
# Ctrl Short — Environment Variables Template
# Copy this file to .env for local development or set in Vercel / AWS SSM
# ==============================================================================

# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# In local development: http://localhost:4000
# In production: Your AWS API Gateway invoke URL (e.g., https://rg3t7y7kak.execute-api.ap-south-1.amazonaws.com/prod)
VITE_API_BASE_URL=https://rg3t7y7kak.execute-api.ap-south-1.amazonaws.com/prod

# Local Development Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:5173

# AWS Cloud Infrastructure & Credentials
# ------------------------------------------------------------------------------
# Primary deployment region (e.g., ap-south-1, us-east-1)
AWS_REGION=ap-south-1
CDK_DEFAULT_ACCOUNT=548171706026
CDK_DEFAULT_REGION=ap-south-1

# Amazon DynamoDB Tables
# ------------------------------------------------------------------------------
URLS_TABLE_NAME=CtrlShort-Urls
ANALYTICS_TABLE_NAME=CtrlShort-Analytics
USER_GSI_NAME=userId-createdAt-index

# Amazon SQS Click Ingestion Queue
# ------------------------------------------------------------------------------
ANALYTICS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/548171706026/CtrlShort-AnalyticsQueue

# Amazon Cognito Authentication
# ------------------------------------------------------------------------------
COGNITO_USER_POOL_ID=ap-south-1_ayzCW1psG
COGNITO_CLIENT_ID=62a8bido8tol5h8inr0iccd35q
VITE_COGNITO_USER_POOL_ID=ap-south-1_ayzCW1psG
VITE_COGNITO_CLIENT_ID=62a8bido8tol5h8inr0iccd35q

# Privacy & Analytics Hashing Salt
# ------------------------------------------------------------------------------
# High-entropy salt used to compute daily SHA-256 visitor hashes (zero raw IP persistence)
ANALYTICS_SALT=ctrl-short-production-privacy-salt-replace-in-prod
